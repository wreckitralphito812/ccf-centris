# Copy to .env.local and fill in. Never commit .env.local.

# YouTube Data API v3 key, server-side only (no NEXT_PUBLIC_ prefix).
# Restrict the key to the YouTube Data API v3, and to your server's IP.
YOUTUBE_API_KEY=

# CCF's official channel (@CCFmainTV)
YOUTUBE_CHANNEL_ID=UCF1Wrrlls2ioQyn5WG-_nIQ

# --- Supabase -------------------------------------------------------------
# Leave blank to run on static seed data. Set them to read reservations and
# inquiries from Postgres and enable the write-path forms.
SUPABASE_URL=
# Service-role key — server only, bypasses RLS, never prefixed NEXT_PUBLIC_.
# All database access goes through it, member pages included.
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (member sign-in) ------------------------------------------
# Member accounts need these AND the Supabase settings above.
# Web app config (Firebase console > Project settings > Your apps). Public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account (Project settings > Service accounts > Generate new private
# key). Server only. Write the key's newlines as \n if your host needs one line.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The CCF Centris satellite row's UUID. Optional; defaults to the seed id.
CENTRIS_SATELLITE_ID=

# --- Admin console -----------------------------------------------------
# Shared passphrase for /admin. Unset => the console is read-only and
# approve/decline actions refuse.
ADMIN_ACCESS_CODE=

# --- Email (Resend) ----------------------------------------------------
# Booking confirmations. Unset => emails are skipped (bookings still work).
RESEND_API_KEY=

# Day-before reminder emails (/api/cron/reminders), run daily by Vercel Cron at
# 10 AM Manila (vercel.json). Any long random string; Vercel sends it with each
# cron call. Unset: the route refuses every call, so no reminders go out.
CRON_SECRET=
# Sender, once CCF Centris' domain is verified in Resend, e.g.
# "CCF Centris <reservations@ccfcentris.org.ph>". Unset => Resend's test sender,
# which only delivers to the Resend account owner's address.
EMAIL_FROM=

# --- Site --------------------------------------------------------------
# Canonical URL for link previews, the sitemap, and links in emails.
# Unset => https://ccfcentris.org.ph.
NEXT_PUBLIC_SITE_URL=

